# Kaggle API Credentials (Optional - only needed if downloading private datasets)
# Generate from: https://www.kaggle.com/settings -> "Create New Token"
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_api_key_here

# Random Seed for Reproducibility
RANDOM_SEED=42

# Environment Mode: local, test, or production
ENV_MODE=local
